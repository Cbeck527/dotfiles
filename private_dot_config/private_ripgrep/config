# Ripgrep configuration file
# Set RIPGREP_CONFIG_PATH to point to this file

# Search options
--smart-case
--hidden
--follow

# Colors
--colors=line:fg:yellow
--colors=line:style:bold
--colors=path:fg:green
--colors=path:style:bold
--colors=match:fg:red
--colors=match:style:bold

# Exclude directories
--glob=!.git/
--glob=!node_modules/
--glob=!target/
--glob=!dist/
--glob=!build/
--glob=!.next/
--glob=!.cache/
--glob=!vendor/
--glob=!*.min.js
--glob=!*.map
--glob=!package-lock.json
--glob=!yarn.lock
--glob=!Cargo.lock
--glob=!go.sum

# Type additions
--type-add=web:*.{html,css,scss,js,jsx,ts,tsx,vue,json}
--type-add=config:*.{toml,yaml,yml,json,ini,conf}
--type-add=docs:*.{md,rst,txt,adoc}

# Default to 3 lines of context
--context=3