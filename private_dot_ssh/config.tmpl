# SSH Client Configuration with Security Best Practices
# Managed by chezmoi

# Include any local/work-specific configs first
Include ~/.ssh/config.local

# Include Colima SSH config
Include ~/.config/colima/ssh_config

# Global defaults for all hosts
Host *
    # Security: Use only secure algorithms
    Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com
    KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group-exchange-sha256
    HostKeyAlgorithms ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,ssh-rsa,rsa-sha2-512,rsa-sha2-256

    # Authentication
    PasswordAuthentication no
    ChallengeResponseAuthentication no
    PubkeyAuthentication yes
    PreferredAuthentications publickey

    # Security settings
    StrictHostKeyChecking ask
    VerifyHostKeyDNS yes
    HashKnownHosts yes

    # Connection settings
    ServerAliveInterval 60
    ServerAliveCountMax 3
    TCPKeepAlive yes
    Compression yes

    # Multiplexing for performance
    ControlMaster auto
    ControlPath ~/.ssh/controlmasters/%r@%h:%p
    ControlPersist 10m

    # Agent forwarding (disabled by default for security)
    ForwardAgent no

    # X11 forwarding (disabled by default for security)
    ForwardX11 no
    ForwardX11Trusted no

    # Other security settings
    PermitLocalCommand no
    UpdateHostKeys yes

    # macOS specific: Use keychain for SSH keys
    {{- if eq .chezmoi.os "darwin" }}
    UseKeychain yes
    AddKeysToAgent yes
    {{- end }}
