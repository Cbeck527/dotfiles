#!/usr/bin/env -S uv run --script
"""Generate Emacs environment variables from current shell.

This script captures environment variables from the current shell
and outputs them in a format that Emacs can load.
"""

import os
import re
import subprocess
import sys

# Environment variables to exclude (based on Doom Emacs)
ENV_DENY_PATTERNS = [
    # Unix/shell state that shouldn't be persisted
    r"^HOME$", r"^(OLD)?PWD$", r"^SHLVL$", r"^PS1$", r"^R?PROMPT$", r"^TERM(CAP)?$",
    r"^USER$", r"^GIT_CONFIG", r"^INSIDE_EMACS$",
    # X server, Wayland, or services' env that shouldn't be persisted
    r"^(WAYLAND_)?DISPLAY$", r"^DBUS_SESSION_BUS_ADDRESS$", r"^XAUTHORITY$",
    # Windows+WSL envvars that shouldn't be persisted
    r"^WSL_INTEROP$",
    # XDG variables that are best not persisted
    r"^XDG_CURRENT_DESKTOP$", r"^XDG_RUNTIME_DIR$",
    r"^XDG_(VTNR|SEAT|BACKEND|SESSION_)",
    # Socket envvars, like I3SOCK, GREETD_SOCK, SEATD_SOCK, SWAYSOCK, etc.
    r"SOCK$",
    # ssh and gpg variables that could quickly become stale if persisted
    r"^SSH_(AUTH_SOCK|AGENT_PID)$", r"^(SSH|GPG)_TTY$",
    r"^GPG_AGENT_INFO$",
    # Internal Emacs/shell envvars
    r"^DEBUG$", r"^INSECURE$", r"^(EMACS|DOOM(LOCAL)?)DIR$",
    r"^DOOM(PATH|PROFILE)$", r"^__",
    # Add some more common ones
    r"^_$", r"^OLDPWD$", r"^COLUMNS$", r"^LINES$",
    # Terminal color settings that aren't relevant for Emacs
    r"^LESS_TERMCAP"
]

def should_exclude_var(var_name):
    """Check if an environment variable should be excluded."""
    for pattern in ENV_DENY_PATTERNS:
        if re.search(pattern, var_name):
            return True
    return False

def get_env():
    """Get environment variables from current shell."""
    # Use env command to get all environment variables
    env_dict = os.environ.copy()
    
    # Log what shell we're using
    shell = env_dict.get('SHELL', 'unknown')
    print(f"Capturing environment from shell: {shell}", file=sys.stderr)
    
    return env_dict

def format_exec_path(path_str):
    """Convert PATH string to Emacs exec-path format."""
    paths = path_str.split(':')
    # Add trailing slash to directories and quote them
    formatted_paths = []
    for path in paths:
        if path and os.path.isdir(path):
            # Ensure trailing slash
            if not path.endswith('/'):
                path += '/'
            formatted_paths.append(f'"{path}"')
    return ' '.join(formatted_paths)

def generate_emacs_env():
    """Generate Emacs Lisp code to set environment variables."""
    env = get_env()
    
    # Filter out excluded variables
    filtered_env = {}
    excluded_count = 0
    for key, value in env.items():
        if should_exclude_var(key):
            print(f"Excluding: {key}", file=sys.stderr)
            excluded_count += 1
        else:
            filtered_env[key] = value
    
    print(f"\nTotal environment variables: {len(env)}", file=sys.stderr)
    print(f"Excluded: {excluded_count}", file=sys.stderr)
    print(f"Included: {len(filtered_env)}", file=sys.stderr)
    
    # Generate Emacs Lisp code
    print(";;; env -*- lexical-binding: t; -*-")
    print(";;; Commentary:")
    print(";;; This file is auto-generated by generate-emacs-env")
    print(";;; DO NOT EDIT THIS FILE MANUALLY")
    print(";;; Code:")
    print()
    
    # Set exec-path from PATH
    if 'PATH' in filtered_env:
        exec_path_list = format_exec_path(filtered_env['PATH'])
        print(f"(setq exec-path '({exec_path_list}))")
        print()
        print(f"Found {len(filtered_env['PATH'].split(':'))} directories in PATH", file=sys.stderr)
    
    # Set all included environment variables
    print(";; Set environment variables")
    for var in sorted(filtered_env.keys()):
        # Properly escape the value for Emacs Lisp
        escaped_value = filtered_env[var].replace('\\', '\\\\').replace('"', '\\"')
        print(f'(setenv "{var}" "{escaped_value}")')
    
    print()
    print(";;; env ends here")

if __name__ == '__main__':
    generate_emacs_env()

# Local Variables:
# mode: python
# End:
